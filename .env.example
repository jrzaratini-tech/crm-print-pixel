NODE_ENV=production
CRM_USERNAME=admin
CRM_PASSWORD=troque-por-uma-senha-longa-e-unica
CRM_ALLOWED_ORIGINS=https://crm-print-pixel.onrender.com
CRM_COMPANY_NIF=coloque-o-nif-da-empresa
CRM_MOBILE_ACCESS_KEY=troque-por-uma-chave-movel-longa-e-exclusiva
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# Alternativas aceitas no Render:
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-do-json
# FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase-service-account.json

# O controlo mensal de rótulos começa em setembro de 2026; meses anteriores não aparecem como dívida.
LABEL_OPEN_BALANCE_START_MONTH=2026-09

# A integracao inicia em modo seguro. Para o plano Flex/API, preencha os campos
# abaixo, use o callback exato no painel Developer do Moloni e mude para live.
MOLONI_MODE=mock
MOLONI_CLIENT_ID=
MOLONI_CLIENT_SECRET=
MOLONI_REDIRECT_URI=https://crm-print-pixel.onrender.com/api/moloni/oauth/callback
MOLONI_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-longa-e-exclusiva

# Stripe Checkout para links de pagamento do CRM.
# Sem STRIPE_SECRET_KEY o CRM mostra modo de teste interno e nao cria cobrancas reais.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_RETURN_BASE_URL=https://crm-print-pixel.onrender.com

# Ligação oficial da conta ChatGPT Pro ao Gestor IA (sem chave de API paga).
# Gere uma chave longa e exclusiva para cifrar os tokens no servidor.
CHATGPT_SIGN_IN_ENABLED=false
CHATGPT_TOKEN_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-24-caracteres

# Shopify: domínio canónico, segredo de webhooks e token Admin com acesso mínimo a pedidos.
SHOPIFY_SHOP_DOMAIN=sua-loja.myshopify.com
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# Bucket privado usado pelos scripts de backup e restauro.
FIREBASE_BACKUP_BUCKET=
